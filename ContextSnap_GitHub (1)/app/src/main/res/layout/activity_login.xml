<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:text="Login" android:textSize="24sp" android:textStyle="bold"
        android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <EditText android:id="@+id/editEmail" android:hint="Email" android:inputType="textEmailAddress"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/editPassword" android:hint="Password" android:inputType="textPassword"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/textError" android:textColor="#D32F2F" android:layout_marginTop="8dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/buttonLogin" android:text="Login" android:layout_marginTop="16dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/buttonFingerprint" android:text="Login with fingerprint" android:visibility="gone"
        android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/textForgot" android:text="Forgot Password?" android:textColor="#1565C0"
        android:padding="8dp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/textSignUp" android:text="Create Account" android:textColor="#1565C0"
        android:padding="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
